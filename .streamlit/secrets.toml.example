# Copy this file to .streamlit/secrets.toml (never commit that file).
# Online: paste the same lines into Streamlit Community Cloud > App settings > Secrets.
# Any key you leave out simply hides or disables that provider.

GEMINI_API_KEY = ""        # free: https://aistudio.google.com/apikey
GROQ_API_KEY = ""          # free: https://console.groq.com/keys
OPENROUTER_API_KEY = ""    # free: https://openrouter.ai/keys

# Optional: override default model names (free model names change now and then)
# GEMINI_MODEL = "gemini-3.5-flash-lite"
# GROQ_MODEL = "llama-3.3-70b-versatile"
# OPENROUTER_MODEL = "meta-llama/llama-3.3-70b-instruct:free"
# OLLAMA_MODEL = "qwen2.5:7b"
